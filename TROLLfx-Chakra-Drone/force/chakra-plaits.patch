diff --git a/tests/chakra.c b/tests/chakra.c
new file mode 100755
index 0000000..0200d6d
--- /dev/null
+++ b/tests/chakra.c
@@ -0,0 +1,64 @@
+/* Chakra integration: held preset/manual voice, release, MIDI coexistence and all-notes-off. */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "params.h"
+
+typedef struct AEffect AEffect;
+typedef intptr_t (*cb)(AEffect*,int32_t,int32_t,intptr_t,void*,float);
+struct AEffect { int32_t magic; intptr_t (*d)(AEffect*,int32_t,int32_t,intptr_t,void*,float);
+ void*p; void (*setP)(AEffect*,int32_t,float); float (*getP)(AEffect*,int32_t);
+ int32_t np,npar,ni,no,flags; intptr_t r1,r2; int32_t a,b,c; float io; void*obj,*user; int32_t uid,ver;
+ void (*pr)(AEffect*,float**,float**,int32_t); void*pdr; char f[56]; };
+typedef struct { int32_t type,byteSize,deltaFrames,flags,noteLength,noteOffset; unsigned char m[4]; char x[4]; } ME;
+typedef struct { int32_t n; intptr_t r; void* ev[2]; } EV;
+extern AEffect* VSTPluginMain(cb);
+
+static intptr_t host(AEffect*e,int32_t op,int32_t i,intptr_t v,void*p,float o) {
+    static double ti[16];
+    (void)e; (void)i; (void)v; (void)p; (void)o;
+    if (op == 7) { ti[4] = 120.0; ((int32_t*)&ti[8])[5] = 1 << 10; return (intptr_t)ti; }
+    return 0;
+}
+static int idx(const char *k) { for (int i=0;i<NPARAMS;i++) if (!strcmp(PARAMS[i].key,k)) return i; return -1; }
+static void setv(AEffect *a, const char *k, float real) {
+    int i=idx(k); a->setP(a,i,(real-PARAMS[i].min)/(PARAMS[i].max-PARAMS[i].min));
+}
+static void midi(AEffect *a, int st, int d1, int d2) {
+    ME m={1,sizeof(ME),0,0,0,0,{(unsigned char)st,(unsigned char)d1,(unsigned char)d2,0},{0}};
+    EV ev={1,0,{&m,0}}; a->d(a,25,0,0,&ev,0);
+}
+static double run(AEffect *a, int blocks) {
+    float L[128],R[128],*o[2]={L,R}; double s=0.0;
+    for(int b=0;b<blocks;b++){a->pr(a,0,o,128);for(int i=0;i<128;i++)s+=L[i]*L[i]+R[i]*R[i];}
+    return sqrt(s/(blocks*256.0));
+}
+static int fails;
+#define CHECK(c,...) do{printf("%s ",(c)?"ok  ":"FAIL");printf(__VA_ARGS__);printf("\n");if(!(c))fails++;}while(0)
+
+int main(void) {
+    AEffect *a=VSTPluginMain(host);
+    int model=idx("model"), gate=idx("chakra_gate");
+    CHECK(a && a->ni==0 && a->no==2 && (a->flags&(1<<8)), "VST is a MIDI instrument with stereo output");
+    CHECK(model>=0 && PARAMS[model].nopts==24, "all 24 Plaits models are exposed");
+    CHECK(idx("chakra_source")>=0 && idx("chakra_root")>=0 && idx("chakra_hz")>=0 && gate>=0,
+          "preset/manual fundamental controls are exposed");
+    setv(a,"model",8); setv(a,"voice_mode",1); setv(a,"polyphony",4); setv(a,"amp_mode",0);
+    setv(a,"chakra_root",3); setv(a,"chakra_gate",1);
+    double preset=run(a,120);
+    CHECK(preset>1e-4,"Heart 639 Hz preset triggers native Plaits audio (rms %.6f)",preset);
+    setv(a,"chakra_source",1); setv(a,"chakra_hz",440); double manual=run(a,80);
+    CHECK(manual>1e-4,"manual Hz retunes the held Chakra voice (rms %.6f)",manual);
+    midi(a,0x90,60,100); double both=run(a,10); setv(a,"chakra_gate",0); double midi_only=run(a,10);
+    CHECK(both>1e-5 && midi_only>1e-5,"ordinary MIDI remains active after Chakra release (both %.6f, MIDI %.6f)",
+          both,midi_only);
+    midi(a,0x80,60,0); run(a,1200);
+    setv(a,"chakra_gate",1); run(a,20); midi(a,0xB0,123,0);
+    CHECK(a->getP(a,gate)<0.5f,"MIDI all-notes-off clears the Chakra hold state");
+    double released=run(a,1200);
+    CHECK(released<preset*0.25,"release decays the Chakra voice (rms %.6f)",released);
+    printf("%s\n",fails?"FAILED":"PASSED");
+    a->d(a,1,0,0,0,0);
+    return fails!=0;
+}
